<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Shadowing records the learner's voice. Without this, the hardened runtime
       refuses the microphone silently and OoFR never appears in System Settings. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
