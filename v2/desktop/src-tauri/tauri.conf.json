{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OoFR Online",
  "version": "3.0.0",
  "identifier": "com.aarynyan.oofr.online",
  "build": {
    "frontendDist": "../../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "OoFR 法语磁带 · 在线版",
        "width": 1280,
        "height": 840,
        "minWidth": 390,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; media-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Education",
    "shortDescription": "法语磁带：听读、跟读、练习",
    "longDescription": "用自选素材学法语：听读、跟读、练习和复习；译文和句子讲解由这台电脑上的本机 AI 生成，不上传网络。",
    "copyright": "Copyright © 2026 OoFR",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-",
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist"
    }
  }
}
