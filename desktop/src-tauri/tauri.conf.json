{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OoFR",
  "version": "1.0.0",
  "identifier": "com.aarynyan.oofr",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "OoFR 法语磁带",
        "width": 1280,
        "height": 840,
        "minWidth": 390,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://*.wiktionary.org"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "category": "Education",
    "shortDescription": "法语与英语学习磁带",
    "longDescription": "使用自选素材学习法语或英语，并通过本地 AI 生成译文与讲解。",
    "copyright": "Copyright © 2026 OoFR",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": null,
      "infoPlist": "Info.plist"
    }
  }
}
